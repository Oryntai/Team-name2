# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Ключ Claude API (модели Haiku 5.5 и Sonnet 5.5)
ANTHROPIC_API_KEY=

# Ссылка GET из гайда организаторов (кнопка «Открыть GET для DEV»); group_id подставляется из интерфейса
CQA_DATASET_URL=

# Своя модель на OpenAI-совместимом сервере (необязательно), например http://127.0.0.1:8080/v1
CQA_LOCAL_BASE_URL=
CQA_LOCAL_MODEL=
